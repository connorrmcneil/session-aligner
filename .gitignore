# Runtime logs (aligner.log, wake.log, preflight.log, wake.daemon.log, etc.)
*.log

# User config, written by `setup`/`times` (local to each machine; not shipped)
aligner.config

# Wake-scheduler single-instance lock (transient; cleaned on exit)
.wake-schedule.lock/

# Last known-good auth marker (runtime state)
.session-aligner-state

# macOS
.DS_Store

# graphify knowledge-graph output (generated)
graphify-out/
