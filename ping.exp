#!/usr/bin/expect -f
#
# ping.exp - Drive the INTERACTIVE Claude Code TUI to send one tiny message.
#
# Why interactive (not `claude -p`): since the June 15, 2026 billing split,
# headless `claude -p` no longer counts toward the Pro/Max 5-hour subscription
# session window (it bills a separate metered pool). Only interactive Claude
# Code starts that window. This drives the real interactive TUI via a pty so the
# ping uses the interactive/subscription path.
#
# Usage: expect ping.exp /absolute/path/to/claude
#
# It types "hi", waits for Claude's reply to FULLY complete, then exits cleanly.
# (It must not interrupt the reply: an interrupted turn produces ~0 tokens and
# may not reliably start the 5-hour window.)

set timeout 30

# First arg = absolute path to the claude binary (resolved by ping.sh).
if {[llength $argv] < 1} {
  puts "ERROR: missing path to claude binary"
  exit 2
}
set claude [lindex $argv 0]

# Show the child's output so ping.sh can capture it for logging/diagnostics.
log_user 1

# Launch the interactive TUI with the cheapest model. No -p (that would be
# headless and would not start the subscription window).
spawn $claude --model haiku

# The TUI can open with a per-folder "Do you trust the files in this folder?"
# prompt the first time. Watch briefly (short timeout) and accept it if it shows;
# otherwise fall through quickly once the folder is already trusted.
set timeout 8
expect {
  -re {(?i)do you trust|trust the files|proceed} {
    send "\r"
    exp_continue
  }
  timeout { }
  eof { puts "ERROR: claude exited before prompt"; exit 1 }
}

# Restore a generous timeout for the exit wait below.
set timeout 30

# Give the input box a moment to be ready, then send the ping message.
sleep 3
send "hi\r"

# Wait for the reply to actually complete BEFORE exiting. We never send Ctrl-C:
# interrupting cancels the turn before any tokens are produced (the old bug:
# empty reply, no usage, unreliable window start).
#
# Detection: while generating, the TUI footer shows an interrupt hint
# ("esc to interrupt"); when the reply is done it returns to the idle hint
# ("? for shortcuts"). We watch for generation to start, then for it to finish.
# If either pattern does not match (TUI wording changes between versions), we
# fall through to a generous fixed wait so a slow/throttled reply still finishes.
set timeout 20
expect {
  -re {(?i)esc to interrupt|interrupt} { }
  timeout { }
}
set timeout 60
expect {
  -re {(?i)\? for shortcuts|for shortcuts} { }
  timeout { }
}

# Small grace period so the final characters of the reply are flushed.
sleep 3

# Show usage inside this same session so the captured output (and thus the log)
# contains the "Current session ... Resets H:MM" panel. /usage is a local
# command - it does not call the model, so it costs no extra tokens.
send "/usage\r"
sleep 4
send "\x1b"   ;# Esc to close the usage panel
sleep 1

# Quit cleanly via the slash command (NOT an interrupt).
send "/exit\r"

# Wait for it to quit; if it lingers, force the pty closed so we never hang.
set timeout 20
expect {
  eof { }
  timeout { close }
}
